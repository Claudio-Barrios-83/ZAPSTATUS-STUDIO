# Copiar a .env en la raíz (o apps/web/.env.local según documentación README).
# Renombra este archivo a .env.example si tu entorno oculta .env.*

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis
REDIS_URL=redis://127.0.0.1:6379

# S3 compatible (R2 o MinIO)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=zapstatus-dev
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Worker
WORKER_CONCURRENCY=1
WATERMARK_TEXT=ZapStatus
